using Gtk 4.0;
using Adw 1;

template $CassetteWindow : Adw.ApplicationWindow {
  default-height: 900;
  default-width: 800;

  Adw.ToolbarView player_bar_toolbar {
    bottom-bar-style: raised;
    reveal-bottom-bars: false;
    reveal-top-bars: true;

    [top]
    Adw.HeaderBar headerbar {
      show-start-title-buttons: false;
      margin-top: 0;
      margin-bottom: 0;
      css-classes: ["flat"];
    }

    content: $CassetteSidebar sidebar {
      content: Adw.ToastOverlay toast_overlay {
        $CassetteAuth auth {}
      };
    };

    [bottom]
    $CassettePlayerBar player_bar {
      visible: false;
      window: template;
    }
  }
}
