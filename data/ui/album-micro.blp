using Gtk 4.0;
using Adw 1;

template $CassetteAlbumMicro : Adw.Bin {
  hexpand: false;
  vexpand: false;

  Adw.Clamp {
    maximum-size: 220;

    Button root_button {
      has-frame: false;
      css-classes: ["flat", "no-hover-effect"];
      clicked => $on_clicked();

      Box card_box {
        spacing: 8;
        orientation: vertical;
        css-classes: ["action-card"]; 

        $CassetteCoverImage cover_image {
          cover-size: 200;
          image-widget-size: 200;
        }

        Box {
          orientation: vertical;
          spacing: 4;
          hexpand: true;

          Label album_title {
            label: _("Album");
            justify: center;
            halign: center;
            wrap: true;
            wrap-mode: word_char;
            css-classes: ["heading"];
          }

          Label album_artist {
            label: _("Artist");
            justify: center;
            halign: center;
            wrap: true;
            wrap-mode: word_char;
            css-classes: ["caption", "dim-label"];
          }
        }
      }
    }
  }
}

