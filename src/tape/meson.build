  'lib/ya-m-api/has-id.vala',
  'lib/ya-m-api/has-tracks.vala',
  'lib/ya-m-api/utils.vala',
  'lib/client.vala',
  'lib/content-handler.vala',
  'lib/enums.vala',
  'lib/hash-store.vala',
  'lib/likes-controller.vala',
  'lib/settings.vala',
  'lib/utils.vala',
  'lib/ya-m-helper.vala',
)

tape_lib = static_library(
  'cassette-tape',
  tape_sources,
  dependencies: tape_deps,
  vala_args: tape_vala_args,
  vala_header: 'tape.h',
  vala_vapi: 'libtape-0.2.vapi',
  vala_gir: 'Tape-0.2.gir',
  link_args: ['-lm'],
  install: false,
)

libtape_dep = declare_dependency(
  link_with: tape_lib,
  include_directories: [
    include_directories('.'),
    include_directories('lib'),
  ],
  dependencies: tape_deps
)

meson.override_dependency('libtape-0.2', libtape_dep)
