  'lib/player/gst-player.vala',
  'lib/player/mpris.vala',
  'lib/player/player.vala',
  'lib/ya-m-api/objects/account/about.vala',
  'lib/ya-m-api/objects/additional-info/lyrics-major.vala',
  'lib/ya-m-api/objects/additional-info/lyrics.vala',
  'lib/ya-m-api/objects/additional-info/similar-tracks.vala',
  'lib/ya-m-api/objects/album/album.vala',
  'lib/ya-m-api/objects/album/label.vala',
  'lib/ya-m-api/objects/artist/artist.vala',
  'lib/ya-m-api/objects/artist/counts.vala',
  'lib/ya-m-api/objects/artist/link.vala',
  'lib/ya-m-api/objects/artist/ratings.vala',
  'lib/ya-m-api/objects/collection/collection-tab.vala',
  'lib/ya-m-api/objects/collection/playlist-with-likes.vala',
  'lib/ya-m-api/objects/cover.vala',
  'lib/ya-m-api/objects/download-info.vala',
  'lib/ya-m-api/objects/icon.vala',
  'lib/ya-m-api/objects/landing/in-style.vala',
  'lib/ya-m-api/objects/landing/new-releases.vala',
  'lib/ya-m-api/objects/landing/waves.vala',
  'lib/ya-m-api/objects/library/all-ids.vala',
  'lib/ya-m-api/objects/play.vala',
  'lib/ya-m-api/objects/playlist/case-forms.vala',
  'lib/ya-m-api/objects/playlist/liked-playlist.vala',
  'lib/ya-m-api/objects/playlist/made-for.vala',
  'lib/ya-m-api/objects/playlist/play-counter.vala',
  'lib/ya-m-api/objects/playlist/playlist-absence.vala',
  'lib/ya-m-api/objects/playlist/playlist-recommendations.vala',
  'lib/ya-m-api/objects/playlist/playlist.vala',
  'lib/ya-m-api/objects/playlist/user.vala',
  'lib/ya-m-api/objects/plays.vala',
  'lib/ya-m-api/objects/rotor/block.vala',
  'lib/ya-m-api/objects/rotor/dashboard.vala',
  'lib/ya-m-api/objects/rotor/event.vala',
  'lib/ya-m-api/objects/rotor/feedback.vala',
  'lib/ya-m-api/objects/rotor/id.vala',
  'lib/ya-m-api/objects/rotor/queue.vala',
  'lib/ya-m-api/objects/rotor/restrictions.vala',
  'lib/ya-m-api/objects/rotor/seed.vala',
  'lib/ya-m-api/objects/rotor/sequence.vala',
