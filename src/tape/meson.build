tape_deps = [
  dependency('gee-0.8'),
  dependency('gio-2.0'),
  dependency('gstreamer-app-1.0'),
  dependency('gstreamer-1.0'),
  dependency('json-glib-1.0'),
  dependency('libsoup-3.0'),
  dependency('libxml-2.0'),
  dependency('sqlite3'),
  libapi_base_dep,
]

tape_vala_args = [
  '--abi-stability',
  '--hide-internal',
  '--target-glib', '2.76',
  '--vapidir', meson.current_source_dir() / 'lib',
]

tape_sources = files(
  'lib/config.vapi',
  'lib/cachier/cachier.vala',
  'lib/cachier/controller.vala',
  'lib/cachier/humanity-size.vala',
