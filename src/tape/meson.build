  'lib/ya-m-api/objects/rotor/station-info.vala',
  'lib/ya-m-api/objects/rotor/station-tracks.vala',
  'lib/ya-m-api/objects/rotor/station.vala',
  'lib/ya-m-api/objects/rotor/track-parameters.vala',
  'lib/ya-m-api/objects/rotor/value-heap.vala',
  'lib/ya-m-api/objects/rotor/value.vala',
  'lib/ya-m-api/objects/rotor/wave.vala',
  'lib/ya-m-api/objects/search-result.vala',
  'lib/ya-m-api/objects/track-heap.vala',
  'lib/ya-m-api/objects/track-short.vala',
  'lib/ya-m-api/objects/track/chart.vala',
